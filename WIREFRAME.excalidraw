    {
      "id": "dB8KSo8ts9XoDNOC_t5OZ",
      "type": "text",
      "x": -3919.6240894666316,
      "y": 1468.3775446280224,
      "width": 1647.2764892578125,
      "height": 508.9285714285711,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b69",
      "roundness": null,
      "seed": 854185851,
      "version": 1142,
      "versionNonce": 1690813755,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1770933523874,
      "link": null,
      "locked": false,
      "text": "Devsync was designed for personal improvement as developer,\nbecause it's my first real project, the goal it's to maintain it \nand keep the best experience for users with the tech-skills i have,\nwhile keeping it open source, if you have suggestions, issues \nor want to contribute please visit the repository, \n\nThe page design, it is inspired by some open source pages i use, such \nas CubeDesk, Npmx, and zustand Illustrations are made by Natali Michelle, \n",
      "fontSize": 45.238095238095205,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Devsync was designed for personal improvement as developer,\nbecause it's my first real project, the goal it's to maintain it \nand keep the best experience for users with the tech-skills i have,\nwhile keeping it open source, if you have suggestions, issues \nor want to contribute please visit the repository, \n\nThe page design, it is inspired by some open source pages i use, such \nas CubeDesk, Npmx, and zustand Illustrations are made by Natali Michelle, \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "v9Hihv_fgVHWWNoVccYe0",
      "type": "rectangle",
      "x": -4191.301481547016,
      "y": 2045.8536767332898,
      "width": 2207.9409362131173,
      "height": 308.5155607043212,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
