    {
      "id": "PDmuUO05MgjpcinBNB_8z",
      "type": "text",
      "x": 1184.4535980651413,
      "y": 1140.586764176979,
      "width": 1024.2384230528025,
      "height": 211.40999680634923,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
